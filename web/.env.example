# Firebase web app config (Firebase console → Project settings → Your apps).
# These values are public identifiers, not secrets — access control lives in
# Firestore rules and function auth.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Region the Cloud Functions are deployed to.
VITE_FUNCTIONS_REGION=asia-south1

# Set to "true" for local development against the Firebase emulators
# (firebase emulators:start). Leave empty/false for production builds.
VITE_USE_EMULATORS=
