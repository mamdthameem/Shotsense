# Firebase web app config (Firebase console → Project settings → Your apps).
# Copy this file to web/.env and fill it in. These values are public
# identifiers, not secrets — access control lives in Firestore rules and the
# functions' admin check.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=shotsense-13b1f.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shotsense-13b1f
VITE_FIREBASE_APP_ID=

# Region the Cloud Functions are deployed to.
VITE_FUNCTIONS_REGION=asia-south1

# Local emulators: do NOT set VITE_USE_EMULATORS here or in web/.env.local.
# Put this line in web/.env.development.local instead — only the dev server
# (npm run dev) reads that file, and a production build refuses to run with
# the flag set anywhere it would be read:
#
#   VITE_USE_EMULATORS=true
