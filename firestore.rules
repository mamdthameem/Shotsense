rules_version = '2';

// Admin-only database. Client gateways never read Firestore — they only call
// the licenseCheck endpoint, which runs with server credentials.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Client registry: readable/writable by authenticated admins only.
    match /clients/{clientId} {
      allow read, write: if isAdmin();
    }

    // Admin roster: managed from the Firebase console, never from the app.
    match /admins/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Client logins, mirrored from Firebase Auth for listing. Any admin may read it (every cloud
    // admin has the same access); writes go through the callable functions (the Admin SDK
    // bypasses these rules), so a role or a clientId can never be edited straight from a browser.
    match /clientUsers/{uid} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
